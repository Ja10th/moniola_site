# Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nigeria_school_portal
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret
JWT_SECRET=nigeria_school_portal_super_secret_jwt_key_2024
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
